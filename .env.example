# Copy this file to `.env.local` and fill in your Supabase project values:
#   Supabase Dashboard → your project → Project Settings → API
#
# Both values are safe to ship to the browser: the anon key is protected by
# Row Level Security. Never put the service_role key in a Vite env var.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
