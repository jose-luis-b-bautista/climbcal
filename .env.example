# Copy this file to `.env.local` and fill in your Supabase project values:
#   Supabase Dashboard → your project → Settings → API Keys
#
# VITE_SUPABASE_URL          → the Project URL (https://<ref>.supabase.co)
# VITE_SUPABASE_ANON_KEY     → the PUBLISHABLE key (sb_publishable_…); this is
#                              what a browser app uses. The legacy anon key also
#                              still works here.
#
# Both values are safe to ship to the browser: the publishable key is protected
# by Row Level Security. Never put a SECRET key (sb_secret_…, or the legacy
# service_role key) in a Vite env var — everything prefixed with VITE_ ships to
# users, and a secret key bypasses RLS.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
